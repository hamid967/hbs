-import { describe, expect, it } from "vitest";
+import { describe, expect, it, vi, beforeEach } from "vitest";
 import { buildMvpMetrics, calculateMonthlyMetric } from "./db";
 
 describe("calculateMonthlyMetric", () => {
@@ -27,3 +27,27 @@ describe("calculateMonthlyMetric", () => {
     });
   });
 });
+
+describe("getMvpMetrics tenant isolation", () => {
+  const state = vi.hoisted(() => ({ whereArgs: [] as unknown[] }));
+
+  function chain(value: unknown[]): any {
+    const promise = Promise.resolve(value);
+    return Object.assign(promise, {
+      from: () => chain(value),
+      innerJoin: () => chain(value),
+      where: (condition: unknown) => { state.whereArgs.push(condition); return chain(value); },
+    });
+  }
+
+  beforeEach(() => { state.whereArgs = []; vi.resetModules(); });
+
+  it("scopes the service-requests query to the caller's company via the users join, never to all companies", async () => {
+    vi.doMock("drizzle-orm/mysql2", () => ({ drizzle: () => ({ select: () => chain([]) }) }));
+    const { getMvpMetrics } = await import("./db");
+    await getMvpMetrics(42);
+    // The requests query must apply a company-scoping WHERE clause (via the
+    // users join) — it must never run unfiltered across every tenant.
+    expect(state.whereArgs).toHaveLength(1);
+  });
+});
