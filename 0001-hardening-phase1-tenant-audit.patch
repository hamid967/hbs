diff --git a/server/_core/vitest.setup.ts b/server/_core/vitest.setup.ts
new file mode 100644
index 0000000..f02fd38
--- /dev/null
+++ b/server/_core/vitest.setup.ts
@@ -0,0 +1,10 @@
+// Safe defaults for the test environment only.
+//
+// These exist so `pnpm test` is reproducible on any machine or CI runner
+// without manual env setup. Nothing here touches a real database or a real
+// mailbox — DATABASE_URL is a placeholder that only needs to be *truthy* so
+// getDb() constructs a drizzle client; tests that actually query the
+// database mock the `drizzle-orm/mysql2` module itself (see
+// server/approvalWorkflow.integration.test.ts) rather than hitting this URL.
+process.env.HRHBS_ADMIN_EMAIL ??= "admin@hrhbs.test";
+process.env.DATABASE_URL ??= "mysql://test:test@127.0.0.1:3306/hbs_test";
